  "segmentos": [
    {
      "id": 1,
      "texto": "Na sexta a bolsa nem abriu, mas o medo não tirou folga. O VIX subiu vinte e seis por cento.",
      "inicio": 0.098,
      "fim": 6.142,
      "palavras": [
        0,
        20
      ]
    },
    {
      "id": 2,
      "texto": "O Nasdaq caiu cinco vírgula três por cento, e a Nvidia caiu catorze sob investigação da SEC. Apagou os ganhos do ano.",
      "inicio": 7.082,
      "fim": 14.905,
      "palavras": [
        20,
        42
      ]
    },
    {
      "id": 3,
      "texto": "Na quinta, dezenove, o Ibovespa fechou em cento e sessenta e seis mil, com menos zero vírgula sessenta e nove por cento.",
      "inicio": 15.842,
      "fim": 22.597,
      "palavras": [
        42,
        64
      ]
    },
    {
      "id": 4,
      "texto": "O medo explodiu: o VIX foi a trinta e cinco vírgula oitenta e nove, com máxima de quarenta no dia.",
      "inicio": 23.546,
      "fim": 29.123,
      "palavras": [
        64,
        84
      ]
    },
    {
      "id": 5,
      "texto": "No último pregão, o dólar fechou em cinco reais e noventa e três centavos, com alta de um vírgula quinze. Foi a sexta alta seguida.",
      "inicio": 30.05,
      "fim": 38.329,
      "palavras": [
        84,
        109
      ]
    },
    {
      "id": 6,
      "texto": "O EWZ caiu três vírgula três, menor em catorze meses. Quedas trazem descontos, mas o mercado oscila. Para quem tem perfil, pode valer avaliar com calma.",
      "inicio": 39.266,
      "fim": 50.514,
      "palavras": [
        109,
        135
      ]
    },
    {
      "id": 7,
      "texto": "A B3 reabre na segunda, vinte e três. Acompanhe com atenção, avalie antes de agir. Conteúdo educativo: não é recomendação de investimento.",
      "inicio": 51.458,
      "fim": 62.093,
      "palavras": [
        135,
        157
      ]
    }
  ]
}
